*.fbx   binary
*.obj   binary
*.blend binary
*.dae   binary
*.3ds   binary
*.max   binary
*.c4d   binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.aif   binary
*.aiff  binary
*.mp4   binary
*.mov   binary
*.webm  binary
*.ttf   binary
*.otf   binary
*.dll   binary
*.so    binary
*.a     binary
